{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "朋友圈海报智能体",
    "version": "1.0.0",
    "theme": "light",
    "source": "visual-directions/direction-a-violet-lime.png"
  },
  "color": {
    "background": { "$value": "#FFFDF8", "$type": "color" },
    "surface": { "$value": "#FFFFFF", "$type": "color" },
    "surfaceSubtle": { "$value": "#F7F3FF", "$type": "color" },
    "textPrimary": { "$value": "#160A3A", "$type": "color" },
    "textSecondary": { "$value": "#665E75", "$type": "color" },
    "border": { "$value": "#E8DFF5", "$type": "color" },
    "borderStrong": { "$value": "#D8C7FA", "$type": "color" },
    "brand": { "$value": "#5B16C9", "$type": "color" },
    "brandStrong": { "$value": "#2E0A8A", "$type": "color" },
    "onBrand": { "$value": "#FFFFFF", "$type": "color" },
    "action": { "$value": "#C8FF19", "$type": "color" },
    "actionHover": { "$value": "#B5F000", "$type": "color" },
    "actionPressed": { "$value": "#9ED500", "$type": "color" },
    "onAction": { "$value": "#160A3A", "$type": "color" },
    "attention": { "$value": "#FF8A1F", "$type": "color" },
    "attentionText": { "$value": "#E66C00", "$type": "color" },
    "focusRing": { "$value": "#7C3AED4D", "$type": "color" },
    "danger": { "$value": "#C92A45", "$type": "color" },
    "dangerSurface": { "$value": "#FFF0F3", "$type": "color" },
    "success": { "$value": "#267A35", "$type": "color" },
    "successSurface": { "$value": "#EEFFC0", "$type": "color" },
    "warning": { "$value": "#9A4B00", "$type": "color" },
    "warningSurface": { "$value": "#FFF0DF", "$type": "color" }
  },
  "fontFamily": {
    "sans": {
      "$value": ["Noto Sans SC", "PingFang SC", "Microsoft YaHei", "Inter", "system-ui", "sans-serif"],
      "$type": "fontFamily"
    },
    "latin": {
      "$value": ["Inter", "SF Pro Text", "system-ui", "sans-serif"],
      "$type": "fontFamily"
    }
  },
  "spacing": {
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "5": { "$value": "20px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" },
    "10": { "$value": "40px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" },
    "16": { "$value": "64px", "$type": "dimension" },
    "20": { "$value": "80px", "$type": "dimension" }
  },
  "radius": {
    "sm": { "$value": "10px", "$type": "dimension" },
    "md": { "$value": "16px", "$type": "dimension" },
    "lg": { "$value": "24px", "$type": "dimension" },
    "xl": { "$value": "32px", "$type": "dimension" },
    "pill": { "$value": "999px", "$type": "dimension" }
  },
  "motion": {
    "fast": { "$value": "120ms", "$type": "duration" },
    "base": { "$value": "200ms", "$type": "duration" },
    "slow": { "$value": "320ms", "$type": "duration" }
  }
}
